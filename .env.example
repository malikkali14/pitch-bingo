# Copy to .env and fill in. None of these are secrets (spec 11.5); keep .env out of Git anyway.
FOUNDRY_PROJECT_ENDPOINT=https://pitchbingo-foundry-xyz.services.ai.azure.com/api/projects/pitchbingo
FOUNDRY_MODEL_FAST=gpt-4.1-mini
FOUNDRY_MODEL_QUALITY=gpt-5-mini
STORAGE=memory
COSMOS_ENDPOINT=https://pitchbingo-cosmos-xyz.documents.azure.com:443/
COSMOS_DATABASE=pitchbingo
# Azure only
APPLICATIONINSIGHTS_CONNECTION_STRING=
ENABLE_INSTRUMENTATION=true
# true only on your own machine
ENABLE_SENSITIVE_DATA=false
OTEL_SERVICE_NAME=pitch-bingo
DEFAULT_SEED=2610
LANGUAGES=en,fr
DEV_PANEL=true
